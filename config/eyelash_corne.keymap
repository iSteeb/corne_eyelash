#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <behaviors/num_word.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/*

   &mmv_input_listener {
       input-processors = <&zip_xy_scaler 2 1>;
   };

   &msc_input_listener {
       input-processors = <&zip_xy_scaler 2 1>;
   };

 */

#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10

/ {
    layer_listeners {
        compatible = "zmk,layer-listeners";

        nav_num_feedback {
            layers = <1>;
            bindings = <&rgb_ug RGB_ON &rgb_ug RGB_OFF>;
        };
    };

    behaviors {
        leader: leader {
            compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;

            de_ss {
                sequence = <S S>;
                bindings = <&macro_de_ss>;
            };

            volei {
                sequence = <V V V>;
                bindings = <&volei>;
            };

            duzie {
                sequence = <D D D>;
                bindings = <&duzie>;
            };

            vim_x {
                sequence = <X X>;
                bindings = <&macro_vim_x>;
            };

            vim_sudo_x {
                sequence = <S X X>;
                bindings = <&macro_vim_sudo_x>;
            };
        };

        hold_tap_kp_kp: hold_tap_kp_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_KP_KP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
        };

        comma_semi: comma_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_SEMI";
            bindings = <&kp COMMA>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        dot_colon: dot_colon {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_COLON";
            bindings = <&kp DOT>, <&kp LS(SEMI)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        escape {
            bindings = <&kp ESC>;
            key-positions = <1 0>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <23 24>;
        };

        del {
            bindings = <&kp DELETE>;
            key-positions = <24 25 23>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <24 25>;
        };

        plus {
            bindings = <&kp LS(EQUAL)>;
            key-positions = <7 8>;
            layers = <0>;
        };

        equals {
            bindings = <&kp EQUAL>;
            key-positions = <22 23>;
            layers = <0>;
        };

        minus_underscore {
            bindings = <&kp MINUS>;
            key-positions = <36 37>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <36 23>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <22 37>;
            layers = <0>;
        };

        and {
            bindings = <&kp LS(N7)>;
            key-positions = <22 8>;
        };

        pipe {
            bindings = <&kp LS(BACKSLASH)>;
            key-positions = <23 8>;
        };

        backtic {
            bindings = <&backtick_force>;
            key-positions = <23 7>;
        };

        tilde {
            bindings = <&kp LS(GRAVE)>;
            key-positions = <37 8 23>;
        };

        single_quote {
            bindings = <&single_quote_force>;
            key-positions = <36 22>;
        };

        question {
            bindings = <&kp LS(SLASH)>;
            key-positions = <38 39 37>;
        };

        comma {
            bindings = <&comma_semi>;
            key-positions = <39 38>;
        };

        dot {
            bindings = <&dot_colon>;
            key-positions = <38 37>;
        };

        dollar {
            bindings = <&kp LS(NUMBER_4)>;
            key-positions = <9 8>;
        };

        exclamation {
            bindings = <&kp LS(N1)>;
            key-positions = <36 37 38>;
        };

        asterisk {
            bindings = <&kp LS(N8)>;
            key-positions = <7 8 9>;
        };

        percent {
            bindings = <&kp LS(N5)>;
            key-positions = <22 23 24>;
        };

        at {
            bindings = <&kp LS(NUMBER_2)>;
            key-positions = <8 9 10>;
        };

        caret_force {
            bindings = <&caret_force>;
            key-positions = <23 9 25>;
        };

        tilde_force {
            bindings = <&tilde_force>;
            key-positions = <23 37>;
        };

        hash {
            bindings = <&kp LS(NUMBER_3)>;
            key-positions = <22 7>;
        };

        euro {
            bindings = <&macro_euro>;
            key-positions = <9 10>;
        };

        quotes {
            bindings = <&kp APOSTROPHE>;
            key-positions = <36 22 7>;
        };

        open_parentheses {
            bindings = <&kp LS(N9)>;
            key-positions = <3 4>;
        };

        close_parentheses {
            bindings = <&kp LS(N0)>;
            key-positions = <4 5>;
        };

        open_brackets {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <31 32>;
        };

        close_brackets {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <32 33>;
        };

        angled_open {
            bindings = <&kp LS(COMMA)>;
            key-positions = <16 17>;
        };

        angled_close {
            bindings = <&kp LS(DOT)>;
            key-positions = <17 18>;
        };
    };

    macros {
        volei: volei {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOT &kp LS(V) &kp O &kp L &kp E &kp I &kp B &kp O &kp L &kp N1 &kp N8 &kp N0 &kp N9 &kp LS(N4) &kp RET>;
            label = "VOLEI";
        };

        // € — AltGr+5 (Linux/Win €) then ⇧+⌥+2 (iOS/macOS €). On Linux/Win the second key
        // leaves a stray char after the €; backspace it. iOS is the inverted case (€ lands last).

        macro_euro: macro_euro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press>,
                <&kp RALT>,
                <&macro_tap>,
                <&kp N5>,
                <&macro_release>,
                <&kp RALT>,
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp N2>,
                <&macro_release>,
                <&kp LALT>,
                <&macro_release>,
                <&kp LSHFT>;
        };

        // ß — AltGr+S. Universal for Linux us(intl) + Windows US-Intl; iOS unverified (test it).

        macro_de_ss: macro_de_ss {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp RALT>,
                <&macro_tap>,
                <&kp S>,
                <&macro_release>,
                <&kp RALT>;
        };

        macro_vim_x: macro_vim_x {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESC &kp COLON &kp X &kp ENTER>;
            label = "MACRO_VIM_X";
        };

        macro_vim_sudo_x: macro_vim_sudo_x {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESC &kp COLON &kp W &kp SPACE &kp LS(N1) &kp S &kp U &kp D &kp O &kp SPACE &kp T &kp E &kp E &kp SPACE &kp LS(N5) &kp SPACE &kp LS(DOT) &kp SLASH &kp D &kp E &kp V &kp SLASH &kp N &kp U &kp L &kp L &kp ENTER>;
            label = "MACRO_VIM_SUDO_X";
        };

        duzie: duzie {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R &kp Y &kp LS(Z) &kp N &kp Y &kp C &kp MINUS &kp C &kp I &kp S &kp M &kp Y &kp N1 &kp MINUS &kp J &kp I &kp Q &kp J &kp I &kp X>;
            label = "DUZIE";
        };

        single_quote_force: single_quote_force {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp SPACE>;
            label = "SINGLE_QUOTE_FORCE";
        };

        double_quote_force: double_quote_force {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(SQT) &kp SPACE>;
            label = "DOUBLE_QUOTE_FORCE";
        };

        tilde_force: tilde_force {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(GRAVE) &kp SPACE>;
            label = "TILDE_FORCE";
        };

        backtick_force: backtick_force {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp SPACE>;
            label = "BACKTICK_FORCE";
        };

        caret_force: caret_force {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(NUMBER_6) &kp SPACE>;
            label = "CARET_FORCE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&leader         &kp Q  &kp W  &kp E      &kp R      &kp T                                 &kp UP                &kp Y  &kp U      &kp I   &kp O     &kp P     &hold_tap_kp_kp LC(LS(LA(LEFT_GUI))) LG(QUESTION)
&kp LALT        &kp A  &kp S  &kp D      &kp F      &kp G                       &kp LEFT  &kp LC(L)  &kp RIGHT  &kp H  &kp J      &kp K   &kp L     &kp UP    &hold_tap_kp_kp END HOME
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C      &kp V      &kp B     &kt LEFT_SHIFT              &kp DOWN              &kp N  &kp M      &trans  &kp LEFT  &kp DOWN  &kp RIGHT
                              &kp LCTRL  &kp SPACE  &kp LGUI                                                    &mo 1  &kp ENTER  &mo 2
            >;

            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };

        raise {
            display-name = "NUMBERS";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                      &kp PAGE_UP             &trans  &kp N7  &kp N8  &kp N9  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &kp HOME  &kp INSERT     &kp END  &trans  &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans              &kp PAGE_DOWN           &trans  &kp N1  &kp N2  &kp N3  &trans  &trans
                        &trans  &trans  &trans                                              &trans  &kp N0  &trans
            >;

            sensor-bindings = <&inc_dec_kp DOWN UP>;
        };

        lower {
            display-name = "SHORTCUTS";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                            &mmv MOVE_UP                     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &mmv MOVE_LEFT  &mkp MB1        &mmv MOVE_RIGHT  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                    &mmv MOVE_DOWN                   &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                                                             &trans  &trans  &trans
            >;
        };

        adjust {
            display-name = "FUNCTIONS";
            bindings = <
&none  &none  &none  &none   &none   &none                                  &kp C_BRIGHTNESS_INC                 &kp F12  &kp F7      &kp F8  &kp F9  &trans  &kp LC(LA(DELETE))
&none  &none  &none  &none   &none   &none                 &rgb_ug RGB_TOG  &bt BT_CLR            &bt BT_DISC 1  &kp F11  &kp F4      &kp F5  &kp F6  &trans  &kp LA(LC(INSERT))
&none  &none  &none  &none   &none   &none   &kp K_MUTE                     &kp C_BRIGHTNESS_DEC                 &kp F10  &kp F1      &kp F2  &kp F3  &trans  &kp LC(LS(ESCAPE))
                     &trans  &trans  &trans                                                                      &trans   &bt BT_NXT  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};

#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <behaviors/num_word.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/*

   &mmv_input_listener {
       input-processors = <&zip_xy_scaler 2 1>;
   };

   &msc_input_listener {
       input-processors = <&zip_xy_scaler 2 1>;
   };

 */

#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10

/ {
    layer_listeners {
        compatible = "zmk,layer-listeners";

        nav_num_feedback {
            layers = <1>;
            bindings = <&rgb_ug RGB_ON &rgb_ug RGB_OFF>;
        };
    };

    behaviors {
        leader: leader {
            compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;

            de_ae {
                sequence = <A E>;
                bindings = <&macro_de_ae>;
            };

            de_oe {
                sequence = <O E>;
                bindings = <&macro_de_oe>;
            };

            de_ue {
                sequence = <U E>;
                bindings = <&macro_de_ue>;
            };

            de_ss {
                sequence = <S S>;
                bindings = <&macro_de_ss>;
            };

            es_nn {
                sequence = <N N>;
                bindings = <&macro_es_nn>;
            };

            de_ae_cap {
                sequence = <A I>;
                bindings = <&macro_de_ae_cap>;
            };

            de_oe_cap {
                sequence = <O I>;
                bindings = <&macro_de_oe_cap>;
            };

            de_ue_cap {
                sequence = <U I>;
                bindings = <&macro_de_ue_cap>;
            };

            es_nn_cap {
                sequence = <N I>;
                bindings = <&macro_es_nn_cap>;
            };

            volei {
                sequence = <A C C>;
                bindings = <&volei>;
            };
        };

        dollar_euro: dollar_euro {
            compatible = "zmk,behavior-mod-morph";
            label = "DOLLAR_EURO";
            bindings = <&kp LS(NUMBER_4)>, <&macro_euro>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        hold_tap_kp_kp: hold_tap_kp_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_KP_KP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
        };

        pair_squares_braces: pair_squares_braces {
            compatible = "zmk,behavior-mod-morph";
            label = "PAIR_SQUARES_BRACES";
            bindings = <&pair_squares>, <&pair_braces>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        comma_semi: comma_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_SEMI";
            bindings = <&kp COMMA>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        dot_colon: dot_colon {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_COLON";
            bindings = <&kp DOT>, <&kp LS(SEMI)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        escape {
            bindings = <&kp ESC>;
            key-positions = <1 0>;
        };

        leader {
            bindings = <&leader>;
            key-positions = <18 17>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <23 24>;
        };

        del {
            bindings = <&kp DELETE>;
            key-positions = <23 24 25>;
        };

        minus_underscore {
            bindings = <&kp MINUS>;
            key-positions = <36 37>;
        };

        equals {
            bindings = <&kp EQUAL>;
            key-positions = <7 8>;
            layers = <0>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <38 23>;
            layers = <0>;
        };

        pipe {
            bindings = <&kp LS(BACKSLASH)>;
            key-positions = <37 23>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <36 23>;
        };

        backtic {
            bindings = <&kp GRAVE>;
            key-positions = <22 37>;
        };

        tilde {
            bindings = <&kp LS(GRAVE)>;
            key-positions = <37 24>;
        };

        quotes {
            bindings = <&kp SQT>;
            key-positions = <36 22>;
        };

        question {
            bindings = <&kp LS(SLASH)>;
            key-positions = <38 39 37>;
        };

        comma {
            bindings = <&comma_semi>;
            key-positions = <39 38>;
        };

        dot {
            bindings = <&dot_colon>;
            key-positions = <38 37>;
        };

        open_parentheses {
            bindings = <&kp LS(N9)>;
            key-positions = <3 4>;
        };

        close_parentheses {
            bindings = <&kp LS(N0)>;
            key-positions = <3 2>;
        };

        parentheses_pair {
            bindings = <&pair_parentheses>;
            key-positions = <2 3 4>;
        };

        open_brackets {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <16 17>;
        };

        close_brackets {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <15 16>;
        };

        brackets_pair {
            bindings = <&pair_squares_braces>;
            key-positions = <15 16 17>;
        };

        and {
            bindings = <&kp LS(N7)>;
            key-positions = <8 9 7>;
        };

        dollar_euro {
            bindings = <&dollar_euro>;
            key-positions = <9 10>;
        };

        exclamation {
            bindings = <&kp LS(N1)>;
            key-positions = <36 37 38>;
        };

        asterisk {
            bindings = <&kp LS(N8)>;
            key-positions = <22 23 24>;
        };

        percent {
            bindings = <&kp LS(N5)>;
            key-positions = <22 23 24 25>;
        };

        at {
            bindings = <&kp LS(NUMBER_2)>;
            key-positions = <8 9 10>;
        };

        caret {
            bindings = <&kp LS(NUMBER_6)>;
            key-positions = <23 9 25>;
        };

        hash {
            bindings = <&kp LS(NUMBER_3)>;
            key-positions = <37 24 39>;
        };

        angled_open {
            bindings = <&kp LS(COMMA)>;
            key-positions = <32 31>;
        };

        angled_close {
            bindings = <&kp LS(DOT)>;
            key-positions = <30 31>;
        };

        angled_pair {
            bindings = <&pair_angled>;
            key-positions = <30 31 32>;
        };

        plus {
            bindings = <&kp LS(EQUAL)>;
            key-positions = <22 23>;
            layers = <0>;
        };

        raise {
            bindings = <&mo 1>;
            key-positions = <4 5>;
        };

        lower {
            bindings = <&mo 2>;
            key-positions = <32 33>;
        };
    };

    macros {
        volei: volei {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOT &kp LS(V) &kp O &kp L &kp E &kp I &kp B &kp O &kp L &kp N1 &kp N8 &kp N0 &kp N9 &kp LS(N4) &kp RET>;
            label = "VOLEI";
        };

        // € — AltGr+5 (Linux/Win €) then ⇧+⌥+2 (iOS/macOS €). On Linux/Win the second key
        // leaves a stray char after the €; backspace it. iOS is the inverted case (€ lands last).

        macro_euro: macro_euro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press>,
                <&kp RALT>,
                <&macro_tap>,
                <&kp N5>,
                <&macro_release>,
                <&kp RALT>,
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp N2>,
                <&macro_release>,
                <&kp LALT>,
                <&macro_release>,
                <&kp LSHFT>;
        };

        // ä / Ä — dead diaeresis (⇧+') then a/A. Universal across all US-International layouts.

        macro_de_ae: macro_de_ae {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp SQT>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp A>;
        };

        macro_de_ae_cap: macro_de_ae_cap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp SQT>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp A>,
                <&macro_release>,
                <&kp LSHFT>;
        };

        // ö / Ö — dead diaeresis (⇧+') then o/O.

        macro_de_oe: macro_de_oe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp SQT>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp O>;
        };

        macro_de_oe_cap: macro_de_oe_cap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp SQT>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp O>,
                <&macro_release>,
                <&kp LSHFT>;
        };

        // ü / Ü — dead diaeresis (⇧+') then u/U.

        macro_de_ue: macro_de_ue {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp SQT>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp U>;
        };

        macro_de_ue_cap: macro_de_ue_cap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp SQT>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp U>,
                <&macro_release>,
                <&kp LSHFT>;
        };

        // ß — AltGr+S. Universal for Linux us(intl) + Windows US-Intl; iOS unverified (test it).

        macro_de_ss: macro_de_ss {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp RALT>,
                <&macro_tap>,
                <&kp S>,
                <&macro_release>,
                <&kp RALT>;
        };

        // ñ / Ñ — dead tilde (⇧+`) then n/N. Universal across all US-International layouts.

        macro_es_nn: macro_es_nn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp N>;
        };

        macro_es_nn_cap: macro_es_nn_cap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp N>,
                <&macro_release>,
                <&kp LSHFT>;
        };

        pair_parentheses: pair_parentheses {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N9) &kp LS(N0) &kp LEFT>;
            label = "PAIR_PARENTHESES";
        };

        pair_squares: pair_squares {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT>;
            label = "PAIR_SQUARES";
        };

        pair_braces: pair_braces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LEFT_BRACKET) &kp LS(RIGHT_BRACKET) &kp LEFT>;
            label = "PAIR_BRACES";
        };

        pair_angled: pair_angled {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(COMMA) &kp LS(DOT) &kp LEFT>;
            label = "PAIR_ANGLED";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB         &kp Q  &kp W  &kp E      &kp R      &kp T                                 &kp UP                &kp Y  &kp U      &kp I             &kp O             &kp P             &hold_tap_kp_kp LC(LS(LA(LEFT_GUI))) LG(LS(LA(LC(S))))
&kp LALT        &kp A  &kp S  &kp D      &kp F      &kp G                       &kp LEFT  &kp LC(L)  &kp RIGHT  &kp H  &kp J      &kp K             &kp L             &kp LG(QUESTION)  &hold_tap_kp_kp END HOME
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C      &kp V      &kp B     &kt LEFT_SHIFT              &kp DOWN              &kp N  &kp M      &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &trans
                              &kp LCTRL  &kp SPACE  &kp LGUI                                                    &mo 1  &kp ENTER  &mo 2
            >;

            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };

        raise {
            display-name = "NUMBERS";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                            &mmv MOVE_UP                     &trans  &kp N7  &kp N8  &kp N9  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &mmv MOVE_LEFT  &mkp MB1        &mmv MOVE_RIGHT  &trans  &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                    &mmv MOVE_DOWN                   &trans  &kp N1  &kp N2  &kp N3  &trans  &trans
                        &trans  &trans  &trans                                                             &trans  &kp N0  &trans
            >;

            sensor-bindings = <&inc_dec_kp DOWN UP>;
        };

        lower {
            display-name = "SHORTCUTS";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                      &kp PG_UP           &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &kp HOME  &kp INS    &kp END  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans              &kp PG_DN           &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                                          &trans  &trans  &trans
            >;
        };

        adjust {
            display-name = "FUNCTIONS";
            bindings = <
&none  &none  &none  &none  &none  &none                              &kp C_BRIGHTNESS_INC                   &kp F12  &kp F7      &kp F8  &kp F9  &rgb_ug RGB_TOG  &kp LC(LA(DELETE))
&none  &none  &none  &none  &none  &none           &kp C_VOLUME_DOWN  &kp K_MUTE            &kp C_VOLUME_UP  &kp F11  &kp F4      &kp F5  &kp F6  &bt BT_CLR       &kp LA(LC(INSERT))
&none  &none  &none  &none  &none  &none  &none                       &kp C_BRIGHTNESS_DEC                   &kp F10  &kp F1      &kp F2  &kp F3  &trans           &kp LC(LS(ESCAPE))
                     &none  &none  &none                                                                     &trans   &bt BT_NXT  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};

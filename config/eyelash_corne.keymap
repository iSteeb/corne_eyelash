#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <behaviors/num_word.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/*

   &mmv_input_listener {
       input-processors = <&zip_xy_scaler 2 1>;
   };

   &msc_input_listener {
       input-processors = <&zip_xy_scaler 2 1>;
   };

 */

#define ZMK_MOUSE_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10

/ {
    layer_listeners {
        compatible = "zmk,layer-listeners";

        nav_num_feedback {
            layers = <1>;
            bindings = <&rgb_ug RGB_ON &rgb_ug RGB_OFF>;
        };
    };

    behaviors {
        leader: leader {
            compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;
            de_ae { sequence = <A E>; bindings = <&kp RALT(Q)>; };
            de_oe { sequence = <O E>; bindings = <&kp RALT(P)>; };
            de_ue { sequence = <U E>; bindings = <&kp RALT(Y)>; };
            de_ss { sequence = <U E>; bindings = <&kp RALT(S)>; };
            es_nn { sequence = <N N>; bindings = <&kp RALT(N)>; };
            volei {
                sequence = <P A S S>;
                bindings = <&volei>;
            };
        };

        dollar_euro: dollar_euro {
            compatible = "zmk,behavior-mod-morph";
            label = "DOLLAR_EURO";
            bindings = <&kp LS(NUMBER_4)>, <&kp RALT(NUMBER_5)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        hold_tap_kp_kp: hold_tap_kp_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_KP_KP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
        };

        pair_squares_braces: pair_squares_braces {
            compatible = "zmk,behavior-mod-morph";
            label = "PAIR_SQUARES_BRACES";
            bindings = <&pair_squares>, <&pair_braces>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        comma_semi: comma_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_SEMI";
            bindings = <&kp COMMA>, <&kp SEMI>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        dot_colon: dot_colon {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_COLON";
            bindings = <&kp DOT>, <&kp LS(SEMI)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        hold_tap_clear_kp: hold_tap_clear_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_CLEAR_KP";
            bindings = <&clear_terminal>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
        };
    };

    combos {
        compatible = "zmk,combos";

        escape {
            bindings = <&kp ESC>;
            key-positions = <1 0>;
        };

        leader {
            bindings = <&leader>;
            key-positions = <18 17>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <23 24>;
        };

        del {
            bindings = <&kp DELETE>;
            key-positions = <23 24 25>;
        };

        minus_underscore {
            bindings = <&kp MINUS>;
            key-positions = <36 37>;
        };

        equals {
            bindings = <&kp EQUAL>;
            key-positions = <7 8>;
            layers = <0>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <38 23>;
            layers = <0>;
        };

        pipe {
            bindings = <&kp LS(BACKSLASH)>;
            key-positions = <37 23>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <36 23>;
        };

        backtic {
            bindings = <&kp GRAVE>;
            key-positions = <22 37>;
        };

        tilde {
            bindings = <&kp LS(GRAVE)>;
            key-positions = <37 24>;
        };

        quotes {
            bindings = <&kp SQT>;
            key-positions = <36 22>;
        };

        question {
            bindings = <&kp LS(SLASH)>;
            key-positions = <38 39 37>;
        };

        comma {
            bindings = <&comma_semi>;
            key-positions = <39 38>;
        };

        dot {
            bindings = <&dot_colon>;
            key-positions = <38 37>;
        };

        open_parentheses {
            bindings = <&kp LS(N9)>;
            key-positions = <3 4>;
        };

        close_parentheses {
            bindings = <&kp LS(N0)>;
            key-positions = <3 2>;
        };

        parentheses_pair {
            bindings = <&pair_parentheses>;
            key-positions = <2 3 4>;
        };

        open_brackets {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <16 17>;
        };

        close_brackets {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <15 16>;
        };

        brackets_pair {
            bindings = <&pair_squares_braces>;
            key-positions = <15 16 17>;
        };

        and {
            bindings = <&kp LS(N7)>;
            key-positions = <8 9 7>;
        };

        dollar_euro {
            bindings = <&dollar_euro>;
            key-positions = <9 10>;
        };

        exclamation {
            bindings = <&kp LS(N1)>;
            key-positions = <36 37 38>;
        };

        asterisk {
            bindings = <&kp LS(N8)>;
            key-positions = <22 23 24>;
        };

        percent {
            bindings = <&kp LS(N5)>;
            key-positions = <22 23 24 25>;
        };

        at {
            bindings = <&kp LS(NUMBER_2)>;
            key-positions = <8 9 10>;
        };

        caret {
            bindings = <&kp LS(NUMBER_6)>;
            key-positions = <23 9 25>;
        };

        hash {
            bindings = <&kp LS(NUMBER_3)>;
            key-positions = <37 24 39>;
        };

        angled_open {
            bindings = <&kp LS(COMMA)>;
            key-positions = <32 31>;
        };

        angled_close {
            bindings = <&kp LS(DOT)>;
            key-positions = <30 31>;
        };

        angled_pair {
            bindings = <&pair_angled>;
            key-positions = <30 31 32>;
        };

        plus {
            bindings = <&kp LS(EQUAL)>;
            key-positions = <22 23>;
            layers = <0>;
        };

        raise {
            bindings = <&mo 1>;
            key-positions = <4 5>;
        };

        lower {
            bindings = <&mo 2>;
            key-positions = <32 33>;
        };
    };

    macros {
        volei: volei {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOT &kp LS(V) &kp O &kp L &kp E &kp I &kp B &kp O &kp L &kp N1 &kp N8 &kp N0 &kp N9 &kp LS(N4) &kp RET>;
            label = "VOLEI";
        };

        pair_parentheses: pair_parentheses {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N9) &kp LS(N0) &kp LEFT>;
            label = "PAIR_PARENTHESES";
        };

        pair_squares: pair_squares {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT>;
            label = "PAIR_SQUARES";
        };

        pair_braces: pair_braces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LEFT_BRACKET) &kp LS(RIGHT_BRACKET) &kp LEFT>;
            label = "PAIR_BRACES";
        };

        pair_angled: pair_angled {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(COMMA) &kp LS(DOT) &kp LEFT>;
            label = "PAIR_ANGLED";
        };

        clear_terminal: clear_terminal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(C)) &kp C &kp L &kp E &kp A &kp R &kp RET>;
            label = "CLEAR_TERMINAL";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB         &kp Q  &kp W  &kp E      &kp R      &kp T                                 &kp UP               &kp Y  &kp U      &kp I   &kp O   &kp P   &hold_tap_kp_kp LC(LS(LA(LEFT_GUI))) LG(LS(LA(LC(S))))
&kp LALT        &kp A  &kp S  &kp D      &kp F      &kp G                       &kp LEFT  &trans    &kp RIGHT  &kp H  &kp J      &kp K   &kp L   &trans  &hold_tap_clear_kp 0 LC(LS(C))
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C      &kp V      &kp B     &kt LEFT_SHIFT              &kp DOWN             &kp N  &kp M      &trans  &trans  &trans  &hold_tap_kp_kp LC(C) LC(V)
                              &kp LCTRL  &kp SPACE  &kp LGUI                                                   &mo 1  &kp ENTER  &mo 2
            >;

            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };

        raise {
            display-name = "NUMBERS";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                            &mmv MOVE_UP                     &trans  &kp N7  &kp N8  &kp N9  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &mmv MOVE_LEFT  &mkp MB1        &mmv MOVE_RIGHT  &trans  &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                    &mmv MOVE_DOWN                   &trans  &kp N1  &kp N2  &kp N3  &trans  &trans
                        &trans  &trans  &trans                                                             &trans  &kp N0  &trans
            >;

            sensor-bindings = <&inc_dec_kp DOWN UP>;
        };

        lower {
            display-name = "SHORTCUTS";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                      &kp PG_UP           &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &kp HOME  &kp INS    &kp END  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans              &kp PG_DN           &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                                          &trans  &trans  &trans
            >;
        };

        adjust {
            display-name = "FUNCTIONS";
            bindings = <
&none  &none  &none  &none  &none  &none                              &kp C_BRIGHTNESS_INC                   &kp F13  &kp F7   &kp F8  &kp F9  &rgb_ug RGB_TOG  &kp LC(LA(DELETE))
&none  &none  &none  &none  &none  &none           &kp C_VOLUME_DOWN  &kp K_MUTE            &kp C_VOLUME_UP  &kp F12  &kp F4   &kp F5  &kp F6  &bt BT_CLR       &kp LA(LC(INSERT))
&none  &none  &none  &none  &none  &none  &none                       &kp C_BRIGHTNESS_DEC                   &kp F11  &kp F1   &kp F2  &kp F3  &bt BT_NXT       &kp LC(LS(ESCAPE))
                     &none  &none  &none                                                                     &trans   &kp F10  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
